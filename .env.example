# PRISM Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://prism:prism_dev_password@localhost:5432/prism

# Redis
REDIS_URL=redis://localhost:6379/0

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=prism-audit-queue

# Anthropic (for LLM modules)
ANTHROPIC_API_KEY=

# BuiltWith
BUILTWITH_API_KEY=

# Perplexity (primary intelligence engine)
PERPLEXITY_API_KEY=

# SimilarWeb
SIMILARWEB_API_KEY=

# Apify (LinkedIn scraping)
APIFY_API_KEY=

# Crossbeam (partner overlap intelligence)
CROSSBEAM_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO
