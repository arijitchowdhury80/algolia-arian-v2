  "findings": [
    {
      "id": "F01",
      "title": "NLP / Semantic Search Fails on Activity-Based Queries",
      "category": "semantic_nlp_search",
      "severity": "critical",
      "impact_stat": "56% of e-commerce sites have 'mediocre or worse' search UX",
      "tested_query": "warm jacket for skiing under 300",
      "actual_behavior": "3,758 undifferentiated results returned. Price constraint ($300) ignored. Activity context (skiing) not reflected. Same result count as all other queries \u2014 keyword bag behavior.",
      "screenshot_file": "screenshots/13-nlp-skiing-jacket.png",
      "algolia_solution": "Algolia NeuralSearch interprets activity context, price constraints, and attribute combinations in a single query. 'Warm jacket for skiing under 300' returns ski-appropriate insulated jackets under $300 \u2014 without the shopper touching a filter.",
      "expected_behavior": "Results filtered to ski-appropriate jackets under $300, with activity context (skiing) reflected in product selection",
      "impact_stat_source": "https://baymard.com/blog/ecommerce-search-report-and-benchmark",
      "prospect_description": "The North Face's catalog is organized by activity (Summit Series, Mountain lifestyle, Running, Urban). When shoppers type 'warm jacket for skiing under 300' \u2014 a completely natural query for this brand \u2014 BloomReach returns the same 3,758-item result set as typing a single keyword. The $300 price constraint is ignored. The skiing context is ignored. The shopper must manually filter \u2014 or leave.",
      "algolia_case_study_url": "https://www.algolia.com/customers/lacoste/",
      "algolia_case_study_result": "Lacoste lifted conversion by 37% (62% on mobile) and grew search's sales contribution by 150% using Algolia typo tolerance, synonyms, custom ranking and personalization.",
      "algolia_case_study_company": "Lacoste"
    },
    {
